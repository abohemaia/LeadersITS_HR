<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leadersits_hr_calc_process_form" model="ir.ui.view">
        <field name="name">leadersits.hr.calc.process.form</field>
        <field name="model">leadersits.hr.calc.process</field>
        <field name="arch" type="xml">
            <form string="اجراء حساب">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="state" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="calc_year" readonly="state == 'done'"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="calc_month" readonly="state == 'done'"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="target_type" readonly="state == 'done'"/>
                            <field name="company_ids" widget="many2many_tags"
                                   invisible="target_type != 'company'"
                                   readonly="state == 'done'"/>
                            <field name="employee_ids" widget="many2many_tags"
                                   invisible="target_type != 'employee'"
                                   readonly="state == 'done'"/>
                            <field name="department_ids" widget="many2many_tags"
                                   invisible="target_type != 'department'"
                                   readonly="state == 'done'"/>
                            <field name="job_ids" widget="many2many_tags"
                                   invisible="target_type != 'job'"
                                   readonly="state == 'done'"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                    <div>
                        <button name="action_calculate" type="object"
                                string="اجراء حساب" class="btn-primary"
                                invisible="state == 'done'"/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_leadersits_hr_calc_process_list" model="ir.ui.view">
        <field name="name">leadersits.hr.calc.process.list</field>
        <field name="model">leadersits.hr.calc.process</field>
        <field name="arch" type="xml">
            <list string="اجراء حساب">
                <field name="name"/>
                <field name="calc_year"/>
                <field name="calc_month"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="target_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Confirmation wizard -->
    <record id="view_leadersits_hr_calc_process_confirm_form" model="ir.ui.view">
        <field name="name">leadersits.hr.calc.process.confirm.form</field>
        <field name="model">leadersits.hr.calc.process.confirm</field>
        <field name="arch" type="xml">
            <form string="تأكيد اجراء حساب">
                <group>
                    <field name="calc_process_id" invisible="1"/>
                    <field name="message" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="موافق" class="btn-primary"/>
                    <button string="الغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_leadersits_hr_calc_process" model="ir.actions.act_window">
        <field name="name">اجراء حساب</field>
        <field name="res_model">leadersits.hr.calc.process</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
