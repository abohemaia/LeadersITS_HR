<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_leadersits_hr_operation_data" model="ir.sequence">
        <field name="name">LITS Operation Data</field>
        <field name="code">leadersits.hr.operation.data</field>
        <field name="prefix">OPD/</field>
        <field name="padding">4</field>
    </record>

    <record id="view_leadersits_hr_operation_data_list" model="ir.ui.view">
        <field name="name">leadersits.hr.operation.data.list</field>
        <field name="model">leadersits.hr.operation.data</field>
        <field name="arch" type="xml">
            <list string="بيانات التشغيل">
                <field name="name"/>
                <field name="file_name"/>
                <field name="import_date"/>
                <field name="imported_count"/>
                <field name="updated_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_leadersits_hr_operation_data_form" model="ir.ui.view">
        <field name="name">leadersits.hr.operation.data.form</field>
        <field name="model">leadersits.hr.operation.data</field>
        <field name="arch" type="xml">
            <form string="بيانات التشغيل">
                <header>
                    <button name="action_import" string="استيراد" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset" string="إعادة" type="object"
                            class="btn-secondary" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="excel_file" filename="file_name"
                                   readonly="state != 'draft'"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="import_date"/>
                            <field name="imported_count"/>
                            <field name="updated_count"/>
                        </group>
                    </group>
                    <notebook invisible="not log">
                        <page string="سجل الاستيراد" name="log">
                            <field name="log"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_leadersits_hr_operation_data" model="ir.actions.act_window">
        <field name="name">بيانات التشغيل</field>
        <field name="res_model">leadersits.hr.operation.data</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
